<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:padding="24dp">
  <LinearLayout
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:focusable="true" android:focusableInTouchMode="true">

    <TextView
      android:text="@string/app_name"
      android:textStyle="bold" android:textSize="22sp"
      android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <TextView
      android:text="PlayerLab — entre une URL HLS/DASH et lance la lecture"
      android:textSize="14sp"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginTop="8dp"/>

    <EditText
      android:id="@+id/inputUrl"
      android:hint="URL du flux (m3u8, mpd, ts...)"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:inputType="textUri" android:imeOptions="actionNext" android:layout_marginTop="16dp"/>

    <Button
      android:id="@+id/btnPaste"
      android:text="📋 Coller l'URL"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginTop="8dp"/>

    <EditText
      android:id="@+id/inputReferer"
      android:hint="Referer (optionnel)"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:inputType="textUri" android:imeOptions="actionNext" android:layout_marginTop="8dp"/>

    <EditText
      android:id="@+id/inputCookie"
      android:hint="Cookie (optionnel)"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:inputType="text" android:imeOptions="actionDone" android:layout_marginTop="8dp"/>

    <!-- Make source import entry prominent -->
    <Button
      android:id="@+id/btnSources"
      android:text="Importer une playlist (M3U / Xtream)"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginTop="16dp"/>

    <Button
      android:id="@+id/btnPlay"
      android:text="▶ Lire"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginTop="12dp"/>

  </LinearLayout>
</ScrollView>
