<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="32dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvTitle"
        android:text="NEOSTREAM"
        android:textColor="#1976D2"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:text="Votre plateforme IPTV complète"
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"/>

    <!-- Grid of categories -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

      <!-- Row 1: Live + Series -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:weightSum="2">

        <!-- Live TV Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLive"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:focusable="true"
            android:clickable="true"
            app:cardBackgroundColor="#1976D2"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:gravity="center"
              android:padding="16dp">

            <TextView
                android:text="📺"
                android:textSize="48sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="TV en Direct"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvLiveCount"
                android:text="..."
                android:textColor="#E3F2FD"
                android:textSize="14sp"
                android:visibility="gone"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
          </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Series Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSeries"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:focusable="true"
            android:clickable="true"
            app:cardBackgroundColor="#E91E63"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:gravity="center"
              android:padding="16dp">

            <TextView
                android:text="🎬"
                android:textSize="48sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Séries"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvSeriesCount"
                android:text="..."
                android:textColor="#FCE4EC"
                android:textSize="14sp"
                android:visibility="gone"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
          </LinearLayout>
        </androidx.cardview.widget.CardView>
      </LinearLayout>

      <!-- Row 2: Movies + Radio -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:weightSum="2">

        <!-- Movies Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMovies"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:focusable="true"
            android:clickable="true"
            app:cardBackgroundColor="#9C27B0"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:gravity="center"
              android:padding="16dp">

            <TextView
                android:text="🎥"
                android:textSize="48sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Films"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvMoviesCount"
                android:text="..."
                android:textColor="#F3E5F5"
                android:textSize="14sp"
                android:visibility="gone"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
          </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Radio Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardRadio"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:focusable="true"
            android:clickable="true"
            app:cardBackgroundColor="#FF9800"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:gravity="center"
              android:padding="16dp">

            <TextView
                android:text="📻"
                android:textSize="48sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Radio"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvRadioCount"
                android:text="..."
                android:textColor="#FFF3E0"
                android:textSize="14sp"
                android:visibility="gone"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
          </LinearLayout>
        </androidx.cardview.widget.CardView>
      </LinearLayout>

      <!-- Row 3: Countries + Quality -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:weightSum="2">

        <!-- Countries Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCountries"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:focusable="true"
            android:clickable="true"
            app:cardBackgroundColor="#00897B"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:gravity="center"
              android:padding="16dp">

            <TextView
                android:text="🌍"
                android:textSize="42sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Par Pays"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
          </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Quality Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardQuality"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:focusable="true"
            android:clickable="true"
            app:cardBackgroundColor="#FBC02D"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:gravity="center"
              android:padding="16dp">

            <TextView
                android:text="💎"
                android:textSize="42sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Qualité"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="UHD • FHD • HD"
                android:textColor="#000000"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
          </LinearLayout>
        </androidx.cardview.widget.CardView>
      </LinearLayout>

      <!-- Row 4: Import -->
      <androidx.cardview.widget.CardView
          android:id="@+id/cardImport"
          android:layout_width="match_parent"
          android:layout_height="100dp"
          android:layout_margin="8dp"
          android:focusable="true"
          android:clickable="true"
          app:cardBackgroundColor="#37474F"
          app:cardCornerRadius="12dp"
          app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="16dp">

          <TextView
              android:text="+"
              android:textColor="#FFFFFF"
              android:textSize="36sp"
              android:textStyle="bold"
              android:layout_marginEnd="16dp"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"/>

          <TextView
              android:text="Importer une playlist (M3U / Xtream)"
              android:textColor="#FFFFFF"
              android:textSize="18sp"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"/>
        </LinearLayout>
      </androidx.cardview.widget.CardView>

    </LinearLayout>
  </LinearLayout>
</ScrollView>
