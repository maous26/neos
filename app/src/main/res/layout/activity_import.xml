<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:orientation="vertical" android:padding="24dp"
  android:layout_width="match_parent" android:layout_height="match_parent">

  <TextView android:text="Importer une playlist M3U / Xtream" android:textStyle="bold"
    android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

  <EditText
    android:id="@+id/inputUrl"
    android:hint="http(s)://host/get.php?username=...&amp;password=...&amp;type=m3u_plus&amp;output=m3u8"
    android:inputType="textUri"
    android:layout_marginTop="12dp"
    android:layout_width="match_parent" android:layout_height="wrap_content"/>

  <LinearLayout android:orientation="horizontal"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp">
    <Button android:id="@+id/btnPaste" android:text="Coller" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Space android:layout_width="12dp" android:layout_height="0dp"/>
    <Button android:id="@+id/btnImport" android:text="Importer" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  </LinearLayout>

  <TextView android:text="Tes identifiants ne sont jamais stockés en clair (chiffrement local)."
    android:layout_marginTop="12dp" android:textSize="12sp"
    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
